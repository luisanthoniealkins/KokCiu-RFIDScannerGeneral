<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".module.main.history.transaction.HistoryTransactionFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:layout_marginTop="4dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Tanggal"
            android:orientation="horizontal">

            <AutoCompleteTextView
                android:id="@+id/actv_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/black"
                android:textStyle="bold"/>

        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.button.MaterialButton
            style="?attr/materialButtonOutlinedStyle"
            android:id="@+id/btn_filter"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="Filter"
            android:layout_marginStart="8dp"
            android:insetBottom="0dp"
            android:insetTop="5dp"
            android:drawableEnd="@drawable/ic_baseline_arrow_drop_down_24"
            android:drawableTint="@color/dark_gray_default_boundary_color"
            android:textColor="@color/dark_gray_default_boundary_color"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_chip_container_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="-8dp"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_check_in"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Masuk"
            app:chipBackgroundColor="@color/bg_chip_state_list_green" />

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_check_out"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Keluar"
            app:chipBackgroundColor="@color/bg_chip_state_list_red" />

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_return"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Retur"
            app:chipBackgroundColor="@color/bg_chip_state_list_blue" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_chip_container_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="-8dp"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_broken"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Rusak"
            app:chipBackgroundColor="@color/bg_chip_state_list_brown" />

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_clear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Hapus"
            app:chipBackgroundColor="@color/bg_chip_state_list_gray" />

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_adjustment"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Penyesuaian"
            app:chipBackgroundColor="@color/bg_chip_state_list_yellow" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_chip_container_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:visibility="gone">

        <com.google.android.material.chip.Chip
            style="@style/chip_transactions"
            android:id="@+id/chip_others"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Tambahan"
            app:chipBackgroundColor="@color/bg_chip_state_list_blue_gray" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_margin="6dp"/>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/dv_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="8dp">

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/black"
            android:text="10 Transaksi Terakhir"
            android:textStyle="bold"
            android:paddingVertical="8dp"/>

        <ImageView
            android:id="@+id/imv_done"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_baseline_check_24"
            app:tint="@color/black" />

        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:visibility="gone"
            android:indeterminate="true"
            android:indeterminateTint="@color/black"/>

        <ImageView
            android:id="@+id/imv_fail"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_baseline_clear_24"
            android:visibility="gone"
            app:tint="@color/black" />

        <Button
            android:id="@+id/btn_query_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tampilkan Semua"/>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_item"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="2dp"/>

</LinearLayout>