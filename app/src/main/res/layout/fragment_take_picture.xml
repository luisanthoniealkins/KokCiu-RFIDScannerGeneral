<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/layer1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBaseline_toBottomOf="parent"
        android:layout_marginHorizontal="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clear_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLEAR"/>

            <Button
                android:id="@+id/save_to_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SAVE"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GANTI MODE"/>

            <TextView
                android:id="@+id/tv_mode_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mode 1 titik"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/imgSegmentation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Show Image"
        android:scaleType="fitStart"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/layer1" />

    <com.example.rfid_scanner.module.main.take_picture.OverlayView
        android:id="@+id/overlapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@id/imgSegmentation"
        app:layout_constraintTop_toBottomOf="@id/layer1" />



    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/add_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/purple_700"
        android:text="Add image"
        android:textColor="@android:color/white"
        app:icon="@drawable/ic_baseline_add_24"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/takePicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/purple_700"
        android:contentDescription="Take Picture"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/add_fab"
        app:layout_constraintEnd_toEndOf="@+id/add_fab"
        app:srcCompat="@drawable/ic_baseline_add_24"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/tvTakePictureDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Take Picture"
        app:layout_constraintBottom_toBottomOf="@id/takePicture"
        app:layout_constraintRight_toLeftOf="@id/takePicture"
        app:layout_constraintTop_toTopOf="@id/takePicture" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pickPicture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/purple_700"
        android:contentDescription="Import from gallery"
        app:borderWidth="0dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/takePicture"
        app:layout_constraintEnd_toEndOf="@+id/takePicture"
        app:srcCompat="@drawable/ic_baseline_search_24"
        app:tint="@android:color/white" />

    <TextView
        android:id="@+id/tvPickImageDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:text="Import from gallery"
        app:layout_constraintBottom_toBottomOf="@id/pickPicture"
        app:layout_constraintRight_toLeftOf="@id/pickPicture"
        app:layout_constraintTop_toTopOf="@id/pickPicture" />

</androidx.constraintlayout.widget.ConstraintLayout>